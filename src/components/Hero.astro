---
import { site } from '../data/site';
const [first, ...rest] = site.name.split(' ');
---

<section class="hero" id="accueil">
  {
    site.availability.available && (
      <span class="pill glass">
        <i aria-hidden="true" />
        {site.availability.label}
      </span>
    )
  }
  <h1 class="name chrome">{first}<br />{rest.join(' ')}</h1>
  <p class="lead on-bg">{site.lead}</p>
  <div class="ctas">
    <a class="btn solid" href="#travaux">Voir les projets</a>
    <a class="btn glass" href="#contact">Me contacter</a>
  </div>
</section>

<style>
  .hero { min-height: min(51.25rem, 88vh); display: flex; flex-direction: column; justify-content: center; gap: 1.75rem; padding-block: 4.5rem 6rem; }
  .pill { align-self: flex-start; display: inline-flex; align-items: center; gap: 0.625rem; font: 500 0.8125rem var(--f-mono); padding: 0.5625rem 1.125rem; border-radius: 999px; background: var(--glass); }
  .pill i { width: 0.5rem; height: 0.5rem; border-radius: 50%; background: var(--live); box-shadow: 0 0 0.625rem var(--live); animation: pulse 2.4s ease-in-out infinite; }
  @keyframes pulse { 50% { box-shadow: 0 0 0.125rem var(--live); opacity: 0.6; } }
  .name {
    font-family: var(--f-display);
    font-weight: 400;
    font-size: clamp(2.5rem, 9vw, 7.75rem);
    line-height: 1;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    margin: 0;
    text-wrap: balance;
    filter: drop-shadow(0 0.375rem 1.625rem rgba(var(--shade), 0.7));
  }
  .lead { font-size: clamp(1.0625rem, 1.8vw, 1.3125rem); font-weight: 300; color: var(--soft); max-width: 52ch; margin: 0; }
  .ctas { display: flex; flex-wrap: wrap; gap: 0.75rem; }
</style>
