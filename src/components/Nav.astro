---
import { site } from '../data/site';

const links = [
  { href: '#accueil', label: 'Accueil' },
  { href: '#travaux', label: 'Travaux' },
  { href: '#profil', label: 'Profil' },
  { href: '#contact', label: 'Contact' },
];
---

<header class="top">
  <div class="wrap">
    <nav class="navbar glass" aria-label="Navigation principale">
      <a class="logo" href="#accueil">{site.initials}</a>
      <div class="links" id="nav-links">
        <span class="drop" id="nav-drop" aria-hidden="true"></span>
        {links.map((l, i) => <a href={l.href} class={i === 0 ? 'on' : undefined}>{l.label}</a>)}
      </div>
      <div class="end">
        <button class="theme" id="theme-btn" type="button" aria-label="Activer le thème clair">
          <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.5"></circle><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"></path></svg>
          <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"></path></svg>
        </button>
        <a class="cta" href="#contact">Discutons</a>
      </div>
    </nav>
  </div>
</header>

<style>
  .top { position: sticky; top: env(safe-area-inset-top, 0px); z-index: 50; padding-block: 1rem; }
  .navbar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.5rem 0.5rem 0.5rem 1.375rem; border-radius: 999px; }
  .logo { font-family: var(--f-display); font-size: 0.875rem; letter-spacing: 0.12em; text-decoration: none; }
  .links { position: relative; display: flex; gap: 0.125rem; font-size: 0.875rem; }
  .links a { position: relative; z-index: 1; text-decoration: none; color: var(--muted); padding: 0.5625rem 1rem; border-radius: 999px; transition: color 0.25s; }
  .links a.on, .links a:hover { color: var(--fg); }
  /* goutte de verre qui glisse sous le lien survolé ou la section en cours */
  .drop {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 0;
    border-radius: 999px;
    pointer-events: none;
    background: rgba(var(--ink), 0.09);
    box-shadow: inset 1px 1px 0 -0.5px rgba(var(--ink), 0.55), inset -1px -1px 0 -0.5px rgba(var(--ink), 0.2), inset 0 0 0.75rem rgba(var(--ink), 0.06);
    transition: left 0.5s cubic-bezier(0.3, 1.45, 0.5, 1), width 0.5s cubic-bezier(0.3, 1.45, 0.5, 1), transform 0.25s ease;
  }
  .drop.moving { transform: scaleY(0.82); }
  .cta { font: 500 0.875rem var(--f-body); text-decoration: none; color: var(--btn-fg); background: var(--btn-bg); padding: 0.625rem 1.125rem; border-radius: 999px; box-shadow: inset 0 -2px 0 rgba(0, 0, 0, 0.15); }
  .end { display: flex; align-items: center; gap: 0.375rem; }
  .theme { display: grid; place-items: center; width: 2.375rem; height: 2.375rem; border: 0; border-radius: 50%; cursor: pointer; color: var(--muted); background: transparent; transition: color 0.2s, background 0.2s; }
  .theme:hover { color: var(--fg); background: rgba(var(--ink), 0.08); }
  .theme svg { width: 1.125rem; height: 1.125rem; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .moon { display: none; }
  :global([data-theme='light']) .sun { display: none; }
  :global([data-theme='light']) .moon { display: block; }
  @media (max-width: 640px) {
    .links { display: none; }
  }
</style>

<script>
  const themeBtn = document.getElementById('theme-btn')!;
  const syncThemeLabel = () => {
    themeBtn.setAttribute('aria-label', document.documentElement.dataset.theme === 'light' ? 'Activer le thème sombre' : 'Activer le thème clair');
  };
  syncThemeLabel();
  themeBtn.addEventListener('click', () => {
    const t = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
    document.documentElement.dataset.theme = t;
    document.querySelector<HTMLMetaElement>('meta[name="theme-color"]')!.content = t === 'light' ? '#eceef2' : '#030304';
    try { localStorage.setItem('theme', t); } catch {}
    syncThemeLabel();
  });

  const links = document.getElementById('nav-links')!;
  const drop = document.getElementById('nav-drop')!;
  const anchors = [...links.querySelectorAll<HTMLAnchorElement>('a')];
  let current = anchors[0];
  let t: number | undefined;

  function moveTo(a: HTMLAnchorElement) {
    drop.style.left = a.offsetLeft + 'px';
    drop.style.width = a.offsetWidth + 'px';
    drop.classList.add('moving');
    clearTimeout(t);
    t = window.setTimeout(() => drop.classList.remove('moving'), 220);
  }
  function setCurrent(a: HTMLAnchorElement) {
    current = a;
    anchors.forEach((x) => x.classList.toggle('on', x === a));
    moveTo(a);
  }
  anchors.forEach((a) => a.addEventListener('mouseenter', () => moveTo(a)));
  links.addEventListener('mouseleave', () => moveTo(current));

  // la section visible au milieu de l'écran devient le lien actif
  const io = new IntersectionObserver(
    (entries) => entries.forEach((e) => {
      if (!e.isIntersecting) return;
      const a = anchors.find((x) => x.getAttribute('href') === '#' + e.target.id);
      if (a) setCurrent(a);
    }),
    { rootMargin: '-45% 0px -50% 0px' },
  );
  ['accueil', 'travaux', 'profil', 'contact'].forEach((id) => {
    const s = document.getElementById(id);
    if (s) io.observe(s);
  });
  document.fonts.ready.then(() => moveTo(current));
  addEventListener('resize', () => moveTo(current));
</script>
