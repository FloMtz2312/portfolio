---
// Fond fixe : grille de points qui s'écarte et s'allume autour du curseur (effet loupe),
// avec des bandes de lumière qui la traversent lentement. Dégradé vert → bleu selon la position.
// Remplaçable par <Background /> (gouttes de métal liquide) dans index.astro.
---

<div class="bg" aria-hidden="true"><canvas id="grid-bg"></canvas></div>

<style>
  .bg { position: fixed; inset: 0; z-index: 0; pointer-events: none; }
  canvas { display: block; width: 100%; height: 100%; }

  /* Voile : calme le côté gauche (le texte) et le bas */
  .bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(3, 3, 4, 0.55) 0%, rgba(3, 3, 4, 0.3) 45%, rgba(3, 3, 4, 0) 75%),
      linear-gradient(180deg, rgba(3, 3, 4, 0) 60%, rgba(3, 3, 4, 0.45) 100%);
  }
  :global([data-theme='light']) .bg::after {
    background:
      linear-gradient(90deg, rgba(236, 238, 242, 0.6) 0%, rgba(236, 238, 242, 0.35) 45%, rgba(236, 238, 242, 0) 75%),
      linear-gradient(180deg, rgba(236, 238, 242, 0) 60%, rgba(236, 238, 242, 0.5) 100%);
  }
</style>

<script>
  const canvas = document.getElementById('grid-bg') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  const root = document.documentElement;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  const GAP = 30; // espacement des points (px CSS)
  const LENS = 190; // rayon d'influence du curseur
  const PUSH = 16; // écartement max des points sous le curseur

  let w = 0, h = 0;
  let ink = '255, 255, 255';
  let accent: CanvasGradient | string = '#fff';
  let live = '#59f0a8', ice = '#a9dcff';
  let mx = -1e4, my = -1e4, cx = mx, cy = my;

  function theme() {
    const s = getComputedStyle(root);
    ink = s.getPropertyValue('--ink').trim();
    live = s.getPropertyValue('--live').trim();
    ice = s.getPropertyValue('--ice').trim();
    const g = ctx.createLinearGradient(0, h, w, 0);
    g.addColorStop(0, live);
    g.addColorStop(1, ice);
    accent = g;
  }

  function resize() {
    const dpr = Math.min(devicePixelRatio || 1, 2);
    w = innerWidth;
    h = innerHeight;
    canvas.width = w * dpr;
    canvas.height = h * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    theme();
  }

  function draw(t: number) {
    ctx.clearRect(0, 0, w, h);
    const lit: number[] = []; // x, y, taille, intensité des points allumés

    ctx.fillStyle = `rgba(${ink}, 0.16)`;
    ctx.beginPath();
    for (let gy = GAP / 2; gy < h + GAP; gy += GAP) {
      for (let gx = GAP / 2; gx < w + GAP; gx += GAP) {
        const dx = gx - cx, dy = gy - cy;
        const d = Math.hypot(dx, dy) || 1;
        let f = Math.max(0, 1 - d / LENS);
        f = f * f * (3 - 2 * f);
        // bandes de lumière qui traversent la grille en diagonale
        const band = reduce ? 0 : (0.5 + 0.5 * Math.sin(gx * 0.007 + gy * 0.005 - t * 0.0011)) ** 6;
        const x = gx + (dx / d) * f * PUSH;
        const y = gy + (dy / d) * f * PUSH;
        const s = 1.3 + f * 1.9 + band * 0.7;
        ctx.rect(x - s / 2, y - s / 2, s, s);
        const a = Math.max(f, band * 0.65);
        if (a > 0.03) lit.push(x, y, s, a);
      }
    }
    ctx.fill();

    // halo doux sous le curseur
    if (cx > -1e3) {
      const halo = ctx.createRadialGradient(cx, cy, 0, cx, cy, LENS * 1.4);
      halo.addColorStop(0, `rgba(${ink}, 0.05)`);
      halo.addColorStop(1, `rgba(${ink}, 0)`);
      ctx.fillStyle = halo;
      ctx.fillRect(cx - LENS * 1.4, cy - LENS * 1.4, LENS * 2.8, LENS * 2.8);
    }

    ctx.fillStyle = accent;
    for (let i = 0; i < lit.length; i += 4) {
      ctx.globalAlpha = lit[i + 3];
      const s = lit[i + 2];
      ctx.fillRect(lit[i] - s / 2, lit[i + 1] - s / 2, s, s);
    }
    ctx.globalAlpha = 1;
  }

  resize();
  new MutationObserver(() => { theme(); if (reduce) draw(0); }).observe(root, { attributes: true, attributeFilter: ['data-theme'] });
  addEventListener('resize', () => { resize(); if (reduce) draw(0); });

  if (reduce) {
    draw(0);
  } else {
    addEventListener('pointermove', (e) => {
      mx = e.clientX;
      my = e.clientY;
    }, { passive: true });
    document.addEventListener('pointerleave', () => { mx = my = -1e4; });
    const loop = (t: number) => {
      // sans souris (mobile, curseur hors page), la loupe se promène seule à droite du texte
      const away = mx < -1e3;
      const tx = away ? w * (0.68 + 0.2 * Math.sin(t * 0.00023)) : mx;
      const ty = away ? h * (0.45 + 0.3 * Math.sin(t * 0.00031 + 1)) : my;
      if (cx < -1e3) { cx = tx; cy = ty; }
      const k = away ? 0.03 : 0.12;
      cx += (tx - cx) * k;
      cy += (ty - cy) * k;
      draw(t);
      requestAnimationFrame(loop);
    };
    requestAnimationFrame(loop);
  }
</script>
