---
import { site } from '../data/site';
const { endpoint, turnstileSiteKey } = site.contactForm;
---

<section class="blk" id="contact">
  <div class="contact glass">
    <h2 class="chrome">Un projet en tête&nbsp;?</h2>
    <p class="note">{site.contactNote}</p>
    <div class="mail">
      <a class="addr" href={`mailto:${site.email}`} id="mail">{site.email}</a>
      <button type="button" class="btn solid" id="copy">Copier l’adresse</button>
    </div>
    <span class="copied" id="copied" aria-live="polite"></span>
    {
      endpoint && (
        <form class="form" id="contact-form" action={endpoint} method="post">
          <div class="row">
            <label>
              <span>Nom</span>
              <input name="name" required maxlength="100" autocomplete="name" />
            </label>
            <label>
              <span>E-mail</span>
              <input name="email" type="email" required maxlength="200" autocomplete="email" />
            </label>
          </div>
          <label>
            <span>Message</span>
            <textarea name="message" required minlength="10" maxlength="5000" rows="5"></textarea>
          </label>
          {/* Champ piège : invisible pour un humain, rempli par les robots */}
          <label class="trap" aria-hidden="true">
            Site web <input name="website" tabindex="-1" autocomplete="off" />
          </label>
          <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="auto" data-size="flexible"></div>
          <div class="send">
            <button type="submit" class="btn solid">Envoyer</button>
            <span class="status" id="form-status" role="status"></span>
          </div>
        </form>
      )
    }
    {endpoint && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
  </div>
</section>

<style>
  .contact { --r: 2.25rem; padding: clamp(1.75rem, 5vw, 3.5rem); display: flex; flex-direction: column; gap: 1.25rem; align-items: flex-start; }
  h2 {
    font-family: var(--f-display);
    font-weight: 400;
    font-size: clamp(1.625rem, 4.6vw, 3.5rem);
    line-height: 1.1;
    text-transform: uppercase;
    margin: 0;
    letter-spacing: 0.02em;
    text-wrap: balance;
  }
  .note { margin: 0; font-size: clamp(1.0625rem, 1.8vw, 1.3125rem); font-weight: 300; color: var(--soft); }
  .mail { display: flex; flex-wrap: wrap; gap: 0.625rem; align-items: center; max-width: 100%; }
  .addr {
    font: 500 clamp(0.9375rem, 2vw, 1.1875rem) var(--f-mono);
    text-decoration: none;
    padding: 0.8125rem 1.25rem;
    border-radius: 999px;
    background: var(--well);
    box-shadow: inset 0 0 0 1px rgba(var(--ink), 0.12);
    word-break: break-all;
  }
  .addr:hover { box-shadow: inset 0 0 0 1px var(--ice); }
  .form { display: flex; flex-direction: column; gap: 1rem; width: 100%; max-width: 46rem; margin-top: 0.75rem; padding-top: 1.75rem; border-top: 1px solid rgba(var(--ink), 0.08); }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  label { display: flex; flex-direction: column; gap: 0.375rem; }
  label span { font: 500 0.75rem var(--f-mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
  input, textarea {
    font: 1rem var(--f-body);
    color: var(--fg);
    padding: 0.8125rem 1.125rem;
    border: 0;
    border-radius: 1rem;
    background: var(--well);
    box-shadow: inset 0 0 0 1px rgba(var(--ink), 0.12);
    resize: vertical;
  }
  input:focus-visible, textarea:focus-visible { outline: none; box-shadow: inset 0 0 0 1px var(--ice); }
  .trap { position: absolute; left: -100vw; width: 1px; height: 1px; overflow: hidden; }
  .send { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; }
  .send button:disabled { opacity: 0.6; cursor: wait; }
  .status { font: 0.8125rem var(--f-mono); color: var(--muted); }
  .status.ok { color: var(--live); }
  .status.err { color: #e5484d; }
  @media (max-width: 640px) { .row { grid-template-columns: 1fr; } }
  .copied { font: 0.8125rem var(--f-mono); color: var(--live); min-height: 1.2em; }
</style>

<script>
  const out = document.getElementById('copied')!;
  const mail = document.getElementById('mail')!;
  document.getElementById('copy')!.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(mail.textContent || '');
      out.textContent = 'Adresse copiée';
    } catch {
      const r = document.createRange();
      r.selectNodeContents(mail);
      const s = getSelection();
      s?.removeAllRanges();
      s?.addRange(r);
      out.textContent = 'Adresse sélectionnée : Ctrl/Cmd + C pour copier';
    }
  });

  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  if (form) {
    const status = document.getElementById('form-status')!;
    const button = form.querySelector('button')!;
    const say = (text: string, kind = '') => { status.textContent = text; status.className = 'status ' + kind; };
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      button.disabled = true;
      say('Envoi…');
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form) });
        const data = (await res.json()) as { ok: boolean; error?: string };
        if (data.ok) {
          form.reset();
          say('Message envoyé, merci ! Je te réponds vite.', 'ok');
        } else {
          say(data.error || 'L’envoi a échoué, écris-moi directement par e-mail.', 'err');
        }
      } catch {
        say('L’envoi a échoué, écris-moi directement par e-mail.', 'err');
      } finally {
        (window as any).turnstile?.reset();
        button.disabled = false;
      }
    });
  }
</script>
