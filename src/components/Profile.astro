---
import { profile } from '../data/site';
---

<section class="blk" id="profil">
  <div class="blk-head">
    <h2>Profil</h2>
    {profile.badge && <span class="on-bg">{profile.badge}</span>}
  </div>
  <div class="about">
    <div class="glass">
      <h3>En bref</h3>
      {profile.paragraphs.map((p) => <p>{p}</p>)}
    </div>
    <div class="glass">
      <h3>Stack</h3>
      <dl class="stack">
        {
          profile.stack.map((s) => (
            <div>
              <dt>{s.name}</dt>
              <dd>{s.use}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<style>
  .about { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 1.25rem; }
  .about .glass { padding: 2.125rem; }
  h3 { margin: 0 0 0.75rem; font: 500 0.8125rem var(--f-mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
  p { margin: 0 0 0.875rem; font-size: 1.0625rem; font-weight: 300; color: var(--soft); max-width: 60ch; }
  p:last-child { margin-bottom: 0; }
  .stack { display: grid; grid-template-columns: 1fr 1fr; gap: 0.625rem 1.25rem; font-size: 0.9375rem; margin: 0; }
  .stack div { display: flex; justify-content: space-between; gap: 0.5rem; border-bottom: 1px solid rgba(var(--ink), 0.07); padding-bottom: 0.5rem; }
  dt { margin: 0; }
  dd { margin: 0; font: 0.8125rem var(--f-mono); color: var(--muted); }
  @media (max-width: 900px) { .about { grid-template-columns: 1fr; } }
  @media (max-width: 640px) { .stack { grid-template-columns: 1fr; } }
</style>
