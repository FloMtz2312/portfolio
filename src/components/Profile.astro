---
import { profile } from '../data/site';
---

<section class="blk" id="profil">
  <div class="blk-head">
    <h2>Profil</h2>
    {profile.badge && <span class="on-bg">{profile.badge}</span>}
  </div>
  <div class="about">
    <div class="glass">
      <h3>En bref</h3>
      {profile.paragraphs.map((p) => <p>{p}</p>)}
    </div>
    <div class="glass">
      <h3>Stack</h3>
      <dl class="stack">
        {
          profile.stack.map((s) => (
            <div>
              <dt>{s.name}</dt>
              <dd>{s.use}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<style>
  .about { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 20px; }
  .about .glass { padding: 34px; }
  h3 { margin: 0 0 12px; font: 500 13px var(--f-mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
  p { margin: 0 0 14px; font-size: 17px; font-weight: 300; color: #c9ced8; max-width: 60ch; }
  p:last-child { margin-bottom: 0; }
  .stack { display: grid; grid-template-columns: 1fr 1fr; gap: 10px 20px; font-size: 15px; margin: 0; }
  .stack div { display: flex; justify-content: space-between; gap: 8px; border-bottom: 1px solid rgba(255, 255, 255, 0.07); padding-bottom: 8px; }
  dt { margin: 0; }
  dd { margin: 0; font: 13px var(--f-mono); color: var(--muted); }
  @media (max-width: 900px) { .about { grid-template-columns: 1fr; } }
  @media (max-width: 640px) { .stack { grid-template-columns: 1fr; } }
</style>
